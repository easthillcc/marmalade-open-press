{
  "name": "marmalade-open-press",
  "version": "1.1.0",
  "mcpName": "io.github.easthillcc/marmalade-open-press",
  "description": "Marmalade Open Press: HTML to print-ready CMYK PDF/X-4 for Node.js, with K-only greys and clean blacks on the black plate. Also PDF/X-1a, PDF/X-3 and CMYK TIFF, a JSON report, and an MCP server and a skill for AI assistants. Made by Marmalade (https://marmalade.family).",
  "type": "module",
  "bin": {
    "open-press": "bin/open-press.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "presets",
    "skills",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "example": "node bin/open-press.js examples/poster.html examples/poster.pdf --bleed 3 --check && node bin/open-press.js examples/back-cover.html examples/back-cover.pdf --check",
    "example:x1a": "node bin/open-press.js examples/poster.html examples/poster-x1a.pdf --bleed 3 --format x1a --check"
  },
  "keywords": [
    "cmyk",
    "cmyk-pdf",
    "pdf",
    "pdf-x",
    "pdfx",
    "pdf/x-4",
    "pdf/x-1a",
    "pdf/x-3",
    "html-to-pdf",
    "html-to-cmyk",
    "print",
    "print-ready",
    "prepress",
    "rich-black",
    "k-only",
    "black-plate",
    "icc",
    "icc-profile",
    "color-management",
    "colour-management",
    "output-intent",
    "chromium",
    "playwright",
    "puppeteer",
    "ghostscript",
    "tiff",
    "cli",
    "json",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent-skills",
    "ai-agents",
    "marmalade"
  ],
  "license": "MIT",
  "dependencies": {
    "pdf-lib": "1.17.1",
    "playwright": "1.65.0",
    "sharp": "0.35.5"
  },
  "homepage": "https://marmalade.family",
  "bugs": {
    "url": "https://github.com/easthillcc/marmalade-open-press/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/easthillcc/marmalade-open-press.git"
  },
  "author": {
    "name": "East Hill",
    "url": "https://marmalade.family"
  }
}
